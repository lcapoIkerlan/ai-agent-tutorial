# Name shown to other agents and users (required)
AGENT_NAME=My Agent

# One-line description of what this agent answers questions about (required)
AGENT_DESCRIPTION=Answers questions about the documents in the documents/ folder

# Model in provider/model format, e.g. anthropic/claude-sonnet-5-5, openai/gpt-4o, gemini/gemini-2.5-flash (required)
LLM_MODEL=anthropic/claude-sonnet-5-5

# API key for your provider (fill in only the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# URL where this agent is reachable (optional, default http://localhost:8000)
# PUBLIC_URL=http://localhost:8000

# Secret required from callers (optional).
# WARNING: if unset, the endpoint is open to anyone who can reach it.
# AGENT_API_KEY=
